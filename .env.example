# ==============================================================================
# INTENTLEDGER AI - ENVIRONMENT CONFIGURATION
# ==============================================================================
# All sensitive variables are server-side only. Never prefix secrets with NEXT_PUBLIC_.

# --- PayPal Developer Sandbox ---
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Demonstration Sandbox Payee (Configure with your Sandbox Business Account email)
PAYPAL_DEMO_PAYEE_EMAIL=your-sandbox-business@business.example.com
PAYPAL_DEMO_MERCHANT_NAME=Demo Electronics

# --- Database ---
# PostgreSQL connection string (Neon serverless preferred)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# --- AI Engine (Groq Cloud API) ---
# Obtain from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cryptographic Signing (Ed25519) ---
# Server-side 32-byte Ed25519 seed or private key in base64 / hex format.
# A stable test key will be used if omitted in local development. Never commit real keys.
INTENTLEDGER_SIGNING_KEY_ED25519=
INTENTLEDGER_KEY_VERSION=v1

# --- AG Studio (Optional Sponsor Integration) ---
# AG Studio licence key (Optional for local development / non-commercial evaluation)
AG_STUDIO=
AG_STUDIO_OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o-mini

